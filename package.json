{
  "name": "@ignitionai/cogitator",
  "version": "0.1.0",
  "description": "Cogitator \u2014 panneau de contr\u00f4le web pour pi : agents composables, workspaces, conversations libres, cron. pi package.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cogitator": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/extensions",
    "web/dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build web",
    "build:server": "tsc",
    "build:web": "vite build web",
    "dev": "tsx src/cli.ts",
    "dev:web": "vite web",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
