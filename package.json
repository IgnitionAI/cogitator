{
  "name": "@ignitionai/cogitator",
  "version": "0.3.0",
  "description": "A web control panel for pi: composable agents, workspaces, interactive conversations, and scheduled tasks. A pi package.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cogitator",
    "agents",
    "generative-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgnitionAI/cogitator.git"
  },
  "homepage": "https://github.com/IgnitionAI/cogitator#readme",
  "bugs": {
    "url": "https://github.com/IgnitionAI/cogitator/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cogitator": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/extensions",
    "web/dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run typecheck && vite build web && tsc",
    "build:server": "tsc",
    "build:web": "vite build web",
    "dev": "tsx src/cli.ts",
    "dev:web": "vite web",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ],
    "image": "https://raw.githubusercontent.com/IgnitionAI/cogitator/dev/web/public/icon.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3"
  }
}
